#!/usr/bin/env bash
commit_regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'
if ! grep -qE "$commit_regex" "$1"; then
  echo "ERROR: commit message doesn't follow Conventional Commits."
  echo "Format: <type>(<scope>): <summary>  e.g. feat(player): add crossfade"
  exit 1
fi
